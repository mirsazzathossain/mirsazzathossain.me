{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "components/*": ["./src/components/*"],
      "config": ["./src/config.ts"],
      "utils/*": ["./src/utils/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [".astro/types.d.ts", "src/**/*", "typings.d.ts"],
  "exclude": ["dist", "node_modules"]
}
