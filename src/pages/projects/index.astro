---
import { SITE, WEBSITE_ID, personRef } from "@/utils/schema";
import Layout from "@/layouts/Layout.astro";
import ProjectThumb from "@/components/projects/ProjectThumb.astro";
import { readSiteJson } from "@/utils/json-data";

const projects = await readSiteJson<Project[]>("projects.json");

const THEMES: { id: Project["theme"]; label: string }[] = [
  { id: "rl", label: "Reinforcement learning for LLMs and VLMs" },
  { id: "interp", label: "Interpretability" },
  { id: "medical", label: "Medical AI for Bangla speakers" },
];

const groups = THEMES.map((theme) => ({
  ...theme,
  items: projects.filter((p) => p.theme === theme.id),
})).filter((g) => g.items.length);

const count = (status: Project["status"]) => projects.filter((p) => p.status === status).length;

const STATUS_STYLE: Record<Project["status"], { badge: string; dot: string }> = {
  Ongoing: {
    badge:
      "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-900 dark:bg-emerald-950 dark:text-emerald-300",
    dot: "bg-emerald-500",
  },
  "Under review": {
    badge:
      "border-blue-200 bg-blue-50 text-blue-800 dark:border-blue-900 dark:bg-blue-950 dark:text-blue-300",
    dot: "bg-blue-500",
  },
  "In preparation": {
    badge:
      "border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-300",
    dot: "bg-amber-500",
  },
};

const description =
  "Ongoing research by Mir Sazzat Hossain on reinforcement learning and post-training for LLMs and VLMs, interpretability, and medical AI for Bangla speakers.";

let index = 0;
---

<Layout
  title="Research Projects"
  description={description}
  canonicalPath="/projects"
  breadcrumbName="Projects"
  jsonLd={{
    "@type": "CollectionPage",
    "@id": `${SITE}/projects#webpage`,
    url: `${SITE}/projects`,
    name: "Research projects by Mir Sazzat Hossain",
    isPartOf: { "@id": WEBSITE_ID },
    about: personRef,
    author: personRef,
  }}
>
  <div>
    <header class="mb-8 max-w-[720px]">
      <p class="m-0 mb-1.5 font-mono text-[11px] tracking-[0.14em] text-ink-3 uppercase">
        Research
      </p>
      <h1 class="m-0 font-serif text-[clamp(28px,4.5vw,42px)] leading-[1.05] font-semibold tracking-[-0.02em] text-ink">
        Projects
      </h1>
      <p class="mt-3 mb-0 max-w-[60ch] text-[15px] text-ink-2">
        What I am working on now: reinforcement learning and post-training for LLMs and VLMs,
        interpretability, and medical AI for Bangla speakers.
      </p>
    </header>

    <section class="mb-[26px] grid grid-cols-1 gap-7 rounded-[10px] border border-rule bg-bg-2 p-[18px_22px] md:grid-cols-[1fr_1.4fr]">
      <div class="grid grid-cols-2 content-center gap-3.5 sm:grid-cols-4">
        {[
          { value: projects.length, label: "Projects" },
          { value: count("Ongoing"), label: "Ongoing" },
          { value: count("Under review"), label: "In review" },
          { value: count("In preparation"), label: "In prep." },
        ].map(({ value, label }) => (
          <div>
            <span class="block font-serif text-[28px] leading-none text-ink">{value}</span>
            <span class="mt-1 block font-mono text-[10.5px] tracking-[0.08em] text-ink-3 uppercase">
              {label}
            </span>
          </div>
        ))}
      </div>

      <nav aria-label="Research themes" class="flex flex-col justify-center gap-1.5">
        {groups.map((group, i) => (
          <a
            href={`#theme-${group.id}`}
            class="group flex items-baseline gap-3 text-[13.5px] text-ink-2 transition-colors hover:text-link hover:no-underline"
          >
            <span class="w-5 shrink-0 font-mono text-[10.5px] text-ink-3">
              {String.fromCharCode(65 + i)}
            </span>
            <span class="font-serif">{group.label}</span>
            <span class="ml-auto font-mono text-[11px] text-ink-3">{group.items.length}</span>
          </a>
        ))}
      </nav>
    </section>

    {groups.map((group, i) => (
      <section id={`theme-${group.id}`} class="mb-10 scroll-mt-24">
        <div class="mb-1 flex flex-wrap items-baseline justify-between gap-3 border-b border-rule pb-2">
          <h2 class="m-0 font-mono text-[11px] font-semibold tracking-[0.16em] text-ink-3 uppercase">
            {String.fromCharCode(65 + i)} · {group.label}
          </h2>
          <span class="font-mono text-[11.5px] text-ink-3">
            {group.items.length} {group.items.length === 1 ? "project" : "projects"}
          </span>
        </div>

        {group.items.map((project) => {
          index += 1;
          return (
            <article
              id={project.slug}
              class="grid scroll-mt-24 grid-cols-1 gap-x-8 gap-y-4 border-b border-dashed border-rule py-7 last:border-b-0 md:grid-cols-[240px_1fr]"
            >
              <div class="min-w-0">
                <div class="mb-2.5 flex min-h-5 flex-wrap items-center gap-2">
                  <span class="font-mono text-[11px] tracking-[0.08em] text-ink-3">
                    {String(index).padStart(2, "0")}
                  </span>
                  <span
                    class={`inline-flex items-center gap-[5px] rounded-[3px] border px-[7px] py-[2px] font-mono text-[10px] tracking-[0.04em] whitespace-nowrap ${STATUS_STYLE[project.status].badge}`}
                  >
                    <span
                      class={`h-[5px] w-[5px] rounded-full ${STATUS_STYLE[project.status].dot}`}
                      aria-hidden="true"
                    />
                    {project.status}
                  </span>
                  {project.note && (
                    <span class="font-mono text-[10px] text-ink-3">{project.note}</span>
                  )}
                </div>
                <div class="aspect-[16/10] overflow-hidden rounded-[8px] border border-rule bg-bg-2 p-4 md:aspect-[4/3]">
                  <ProjectThumb slug={project.slug} title={project.title} />
                </div>
                {project.figure && (
                  <p class="m-0 mt-2 font-serif text-[12px] leading-[1.45] text-ink-3 italic">
                    {project.figure}
                  </p>
                )}
              </div>

              <div class="min-w-0">
                <h3 class="m-0 mb-2 font-serif text-[clamp(18px,2.2vw,21px)] leading-[1.3] font-semibold tracking-[-0.01em] text-ink">
                  <a href={`#${project.slug}`} class="text-ink hover:text-link hover:no-underline">
                    {project.title}
                  </a>
                </h3>
                <ul class="m-0 mb-3 flex list-none flex-wrap gap-1 p-0">
                  {project.tags.map((tag) => (
                    <li class="rounded-[3px] border border-rule bg-bg-2 px-[7px] py-[2px] font-mono text-[10px] tracking-[0.04em] text-ink-2">
                      {tag}
                    </li>
                  ))}
                </ul>
                <p class="m-0 max-w-[70ch] font-serif text-[15px] leading-[1.7] text-ink-2">
                  {project.description}
                </p>
              </div>
            </article>
          );
        })}
      </section>
    ))}
  </div>
</Layout>
