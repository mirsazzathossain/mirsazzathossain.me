---
import AboutPage from "@/components/about/AboutPage";
import { SITE, WEBSITE_ID, personRef } from "@/utils/schema";
import Layout from "@/layouts/Layout.astro";
import { readSiteJson } from "@/utils/json-data";

const about = await readSiteJson("about.json");
const educations = await readSiteJson("educations.json");
const experiences = await readSiteJson("experiences.json");
const awards = await readSiteJson("awards.json");
const talks = await readSiteJson("talks.json");
const service = await readSiteJson("service.json");
const press = await readSiteJson("press.json");
const availability = await readSiteJson("availability.json");
const timeline = await readSiteJson("news.json");
---

<Layout
  title="About"
  fullTitle={`About ${about.name} - ${about.designation} & LLM Researcher`}
  name={about.name}
  description={`About ${about.name}, ${about.designation} at ${about.company.name}: research on LLM agents, LLM post-training, policy optimization and formal verification.`}
  canonicalPath="/about"
  breadcrumbName="About"
  jsonLd={{
    "@type": "AboutPage",
    "@id": `${SITE}/about#webpage`,
    url: `${SITE}/about`,
    name: `About ${about.name}`,
    isPartOf: { "@id": WEBSITE_ID },
    about: personRef,
  }}
>
  <AboutPage
    about={about}
    educations={educations}
    experiences={experiences}
    awards={awards}
    talks={talks}
    service={service}
    press={press}
    availability={availability}
    timeline={timeline}
  />
</Layout>
