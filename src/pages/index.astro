---
import { HeroBio, RecentNews } from "@/components/sections/HeroBio";
import { HomeArticles } from "@/components/sections/HomeArticles";
import { HomePublications } from "@/components/sections/HomePublications";
import ProfileSidebar from "@/components/sections/ProfileSidebar";
import pubBase from "@/data/publications.json";
import pubOverrides from "@/data/publications.override.json";
import Layout from "@/layouts/Layout.astro";
import { getSortedPublishedArticles } from "@/utils/articles";
import { readSiteJson } from "@/utils/json-data";
import { mergePublicationOverrides, type Publication } from "@/utils/publications";

const about = await readSiteJson("about.json");
const news = await readSiteJson("news.json");
const publications = mergePublicationOverrides(
  pubBase as Publication[],
  pubOverrides as Partial<Publication>[],
);
const articles = await getSortedPublishedArticles();

const site = (Astro.site?.href ?? Astro.url.origin).replace(/\/$/, "");
const fullTitle = `${about.name} | ${about.designation} & LLM Researcher`;
const description = `${about.name} is an ${about.designation} at ${about.company.name} and an NLP researcher working on LLM agents, LLM post-training, preference optimization, self-distillation, and formal verification.`;
const keywords = [
  about.name,
  "Mir Sazzat",
  "Sazzat Hossain",
  about.designation,
  about.company.name,
  "LLM Researcher",
  "NLP Researcher",
  ...about.researchInterests,
  "Reinforcement Learning for LLMs",
  "Large Language Models",
  "Vision-Language Models",
  "Bangla NLP",
  "CCDS",
  "Independent University, Bangladesh",
  "Dhaka, Bangladesh",
];
const sameAs = [...about.academicLinks, ...about.socialLinks]
  .map((link: { url: string }) => link.url)
  .filter((url: string) => !url.includes("discord.com"));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      url: `${site}/`,
      name: `${about.name} | Personal Website`,
      inLanguage: "en",
      publisher: { "@id": `${site}/#person` },
    },
    {
      "@type": "ProfilePage",
      "@id": `${site}/#profilepage`,
      url: `${site}/`,
      name: fullTitle,
      description,
      isPartOf: { "@id": `${site}/#website` },
      mainEntity: { "@id": `${site}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${site}/#person`,
      name: about.name,
      url: `${site}/`,
      image: `${site}${about.photo}`,
      jobTitle: about.designation,
      worksFor: { "@type": "Organization", name: about.company.name, url: about.company.url },
      alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Independent University, Bangladesh",
        url: "https://iub.edu.bd/",
      },
      address: { "@type": "PostalAddress", addressLocality: "Dhaka", addressCountry: "BD" },
      knowsAbout: [
        ...about.researchInterests,
        "Natural Language Processing",
        "Large Language Models",
      ],
      sameAs,
    },
  ],
};
---

<Layout
  name={about.name}
  fullTitle={fullTitle}
  description={description}
  keywords={keywords}
  canonicalPath="/"
  ogImageAlt={`${about.name}, ${about.designation} at ${about.company.name}`}
  jsonLd={jsonLd}
>
  <section class="grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-[clamp(28px,5vw,56px)] mb-12">
    <ProfileSidebar about={about} />
    <div>
      <HeroBio about={about} />
      <RecentNews news={news} />
      <HomePublications publications={publications} />
      <HomeArticles articles={articles} />
    </div>
  </section>
</Layout>
