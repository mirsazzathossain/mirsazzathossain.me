---
/**
 * Schematic thumbnail for a research project. Inline SVG drawn with
 * currentColor so it follows the site theme (light and dark). Animations are
 * CSS only and switch off under prefers-reduced-motion.
 */
interface Props {
  slug: string;
  title: string;
}

const { slug, title } = Astro.props;
const dots = `dots-${slug}`;
const arrow = `arrow-${slug}`;
const head = `url(#${arrow})`;
const EXPERT = ["text-link", "text-amber-500", "text-emerald-500"];
